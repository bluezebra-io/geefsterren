# ---------------------------------------------------------------------------
# Supabase. All server side: every query runs through a Server Component or a
# server action, so the browser talks to Supabase directly nowhere and none of
# these carry a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Bypasses RLS. Keep it out of anything a browser can reach.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# URLs. One deployment serves all three; the proxy routes by host.
# ---------------------------------------------------------------------------
MARKETING_URL=http://localhost:5010
PORTAL_URL=http://app.localhost:5010
REVIEW_URL=http://localhost:5010

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# 32 bytes base64: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Email. `console` logs instead of sending; use it locally.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=feedback@geefsterren.nl

# ---------------------------------------------------------------------------
# Observability and abuse prevention (optional locally)
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
